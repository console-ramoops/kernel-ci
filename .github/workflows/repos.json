{
  "toolchains": [
    {
      "repo": "https://gitlab.com/clangsantoni/zyc_clang",
      "branch": "14",
      "name": "zyc_clang",
      "binPath": ["bin"]
    }
  ],
  "params": {
    "ARCH": "arm64",
    "CC": "zyc_clang/bin/clang",
    "externalCommand": {
      "CROSS_COMPILE": "zyc_clang/bin/aarch64-linux-gnu-",
      "CROSS_COMPILE_ARM32": "zyc_clang/bin/arm-linux-gnueabi-",
      "LD": "zyc_clang/bin/ld.lld"
    }
  },
  "AnyKernel3": {
    "use": true,
    "release": true,
    "repo": "https://github.com/console-ramoops/AnyKernel3",
    "branch": "master"
  }
}
